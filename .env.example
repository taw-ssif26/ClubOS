# Copy to .env. Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=change-me
SECRET_KEY=change-me-to-48-random-characters-minimum-32   # signs unsubscribe links, encrypts 2FA secrets. NEVER change after launch.

DOMAIN=:80                             # local: :80 (plain HTTP). Production: yourdomain.com (automatic HTTPS)
BASE_URL=http://localhost                  # public origin of the website; used in email links (https://yourdomain.com in prod)
CORS_ORIGINS=http://localhost,http://localhost:3000   # must include BASE_URL; also the CSRF origin allow-list
COOKIE_SECURE=false                   # TRUE in production (HTTPS). Also turns on startup safety checks.
TRUSTED_PROXIES=1                     # proxies in front of the API that APPEND the connecting address (direct-hit protection)
PROXY_SECRET=change-me-48-random-chars   # shared by api + web: lets the API trust the client IP the web proxy forwards
MAX_UPLOAD_MB=5
SENTRY_DSN=                           # optional error tracking

# Leave SMTP_HOST empty in dev: emails (verification links!) print in the worker log.
# Production with Brevo over SMTP: smtp-relay.brevo.com / 587 / user = your Brevo login / password = SMTP key.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ClubOS <no-reply@yourdomain.com>

# --- Free-tier hosts (Render + Neon + Brevo); see DEPLOY-FREE.md ---
BREVO_API_KEY=                        # Brevo API key (HTTPS; use this where outbound SMTP is blocked). SMTP_FROM must be a verified Brevo sender.
EMAIL_DAILY_CAP=0                     # provider daily limit; Brevo free = 300
RUN_WORKER_IN_API=false               # true on hosts without background workers
WORKER_POLL_SECONDS=900
MEDIA_BACKEND=disk                    # db = store images in Postgres (hosts without disks)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
MAX_DOCUMENT_MB=3                     # post attachments (PDF, Word, Excel, PowerPoint, TXT, CSV)
CLUB_APPROVAL_REQUIRED=true           # new clubs wait for super-admin approval (anti-spam); platform admins skip the queue
